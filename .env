# ============================================================
# AI Train Distance Alert System — Environment Configuration
# ============================================================
# Copy this file to .env and edit values as needed.
# The application reads this file automatically at startup.

# --- Application Mode ---
# MOCK  : Use simulated sensor data (no Arduino required)
# HARDWARE : Read real sensor data from Arduino via serial port
APP_MODE=HARDWARE

# --- Serial Port (HARDWARE mode only) ---
# Windows example: COM5
# Linux/Mac example: /dev/ttyUSB0
SERIAL_PORT=COM5
BAUD_RATE=9600

# --- Alert Thresholds (cm) ---
# Object closer than WARNING_DISTANCE triggers a CAUTION/WARNING alert
WARNING_DISTANCE=50
# Object closer than CRITICAL_DISTANCE triggers a CRITICAL alert
CRITICAL_DISTANCE=30

# --- Sampling ---
# Minimum seconds between database writes (avoids duplicate rows)
SAMPLE_INTERVAL=1.0

# --- Flask ---
FLASK_PORT=5000
FLASK_DEBUG=False
